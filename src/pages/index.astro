---
import Base from '../layouts/Base.astro';

const headline =
	'Head of Engineering in Melbourne. I build engineering organisations and the platforms they run on.';

const links = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/senechal' },
	{ label: 'Wine Twins', href: 'https://winetwins.co' },
	{ label: 'nicolas@senechal.me', href: 'mailto:nicolas@senechal.me' },
];
---

<Base title="Nicolas Sénéchal" description={headline}>
	<header>
		<h1>Nicolas Sénéchal</h1>
		<p class="headline">{headline}</p>
	</header>
	<p>
		I lead through engineering managers and technical leaders, and I build that layer before I
		scale a team. At ANZ, that meant growing the web team to 65 and building continuous deployment
		inside a bank.
	</p>
	<p>Before that: SEEK, Pivot, lastminute.com and NVIDIA.</p>
	<p>
		I also build things myself to stay sharp. Wine Twins is a wine recommendation platform where
		agents wrote the code, tests were the gate, and every merge was my call.
	</p>
	<footer>
		<p>Open to Head of Engineering roles in Melbourne and Sydney.</p>
		<ul class="links">
			{links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
		</ul>
	</footer>
</Base>
